 # Include and link Tegra out-of-tree modules.
@@ -159,6 +165,14 @@
 
 ifeq ($(ARCH),x86_64)
  ccflags-y += -mno-red-zone -mcmodel=kernel
+ # [30HX-mod] Harden the out-of-tree module the same way in-tree x86 code is
+ # hardened on modern distro kernels: SLS/IBT shims (CONFIG_SLS / IBT) and
+ # retpoline with external thunks (CONFIG_RETHUNK).  Each flag is probed so
+ # that compilers that do not support it are silently skipped.
+ ccflags-y += $(call cc-option,-mharden-sls=all,)
+ ccflags-y += $(call cc-option,-mindirect-branch=thunk-extern,)
+ ccflags-y += $(call cc-option,-mindirect-branch-register,)
+ ccflags-y += $(call cc-option,-fno-jump-tables,)
 endif
 
