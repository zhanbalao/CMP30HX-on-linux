+# [30HX-mod] conftest.sh single-quotes $(NV_CONFTEST_CFLAGS), so the escaped
+# quotes of the upstream define arrive at the compiler literally and break the
+# compile tests; an unescaped "-DVERSION=615.78.08" is then parsed as 615.78
+# .08.  Give conftest the version string without dots for the define and keep
+# the original (quoted) form for the module sources.
+NV_VERSION_STRING_CONFTEST := 615_78_08
